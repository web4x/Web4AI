      "Bash(./test.suite *)",
      "Bash(./hiveMind *)",
      "Bash(tmux *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sleep *)",

+import { existsSync, statSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { M1Catalog } from '../../MOF/M1/M1Catalog/latest/src/ts/EAM/layer2/M1Catalog.js';
+
+/**
+ * spec/scenario.md §6 SC1 — the EAMD.ucp/ layout restored by S1 (oopTester gate).
+ * Every arm fails by its NAMED reason: a seed must turn RED with exactly that reason, a revert GREEN.
+ */
+const isDir = (p: string): boolean => existsSync(p) && statSync(p).isDirectory();
+
+describe('SC1 layout (spec 13 §6, S1 restore EAMD.ucp) — oopTester', () => {
+  it('SC1 folders: EAMD.ucp/Components, EAMD.ucp/Scenario/Index and EAMD.ucp/Scenario/type exist as directories', () => {
+    for (const p of ['EAMD.ucp/Components', 'EAMD.ucp/Scenario/Index', 'EAMD.ucp/Scenario/type']) {
+      expect(isDir(p), `SC1: ${p} missing`).toBe(true);
+    }
+  });
+
+  it('SC1 no stray root: there is no Components/ at the repository root (everything lives under EAMD.ucp/)', () => {
+    expect(existsSync('Components'), 'SC1: stray Components/ at the repo root').toBe(false);
+  });
+
+  it("SC1 layout == disk: M1Layout's home root is EAMD.ucp and EVERY catalogued class folder it lays out exists on disk under EAMD.ucp/Components/ (derived from the catalog)", () => {
+    const catalog = new M1Catalog().init();
+    const layout = catalog.homeLayout('');
+    const names = catalog.classes().map((c) => c.name);
+    expect(names.length, 'SC1: catalog is empty — a layout check over nothing proves nothing').toBeGreaterThan(0);
+    let checked = 0;
+    for (const name of names) {
+      const path = layout.classFolder(name, 'ts').path;
+      expect(path.startsWith('EAMD.ucp/Components/'), `SC1: layout path of ${name} not under EAMD.ucp/Components/: ${path}`).toBe(true);
+      expect(isDir(path), `SC1: layout path of ${name} not on disk: ${path}`).toBe(true);
+      checked++;
+    }
+    expect(checked, 'SC1: not every catalogued class was checked').toBe(names.length);
+  });
+});

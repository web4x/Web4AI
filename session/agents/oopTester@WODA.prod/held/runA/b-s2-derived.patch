   /** S2: the part ends as `Model.member` strings — read from the catalog's derivation. */
   const partMembers = (catalog: M1Catalog): string[] => [...catalog.partEnds()].flatMap(([model, ends]) => Object.keys(ends).map((end) => `${model}.${end}`)).sort();
 
+  /** The part members spec/model-json.md rule C NAMES today, read from its TEXT (`X.a/b/c` expands) - the S2 oracle; no hand list. */
+  const ruleCMembers = (specText: string): string[] => {
+    const ruleC = specText.split('\n').find((line) => line.startsWith('- **(C) containment PARTS')) ?? '';
+    const named = /today (.*?)\) is STORED/.exec(ruleC)?.[1] ?? '';
+    return [...named.matchAll(/`(\w+)\.([\w/]+)`/g)].flatMap(([, model, ends]) => (ends ?? '').split('/').map((end) => `${model}.${end}`)).sort();
+  };
+
+  it('S2 oracle is FAILABLE - a member SEEDED into the rule C text no longer equals the derivation; a spec WITHOUT rule C parses to [] (caught by the non-hollow guard)', async () => {
+    await M1Catalog.load();
+    const derived = [...partMembers(new M1Catalog().init())].sort();
+    const spec = readFileSync('spec/model-json.md', 'utf8');
+    expect(ruleCMembers(spec)).toEqual(derived);
+    const seeded = spec.replace('`MethodModel.parameters`', '`MethodModel.parameters/seededGhost`');
+    expect(seeded).not.toBe(spec);
+    expect(ruleCMembers(seeded)).not.toEqual(derived);
+    expect(ruleCMembers('no rule C here')).toEqual([]);
+  });
+
   it('S2 — M1Catalog.partEnds() DERIVES exactly the part members spec/model-json.md rule C names today (7), each with its part class', async () => {

-    expect(partMembers(catalog)).toEqual(['ClassModel.attributes', 'ClassModel.imports', 'ClassModel.methods', 'ClassModel.relationships', 'ClassModel.typeAliases', 'MethodModel.parameters', 'ModelUnit.references']);

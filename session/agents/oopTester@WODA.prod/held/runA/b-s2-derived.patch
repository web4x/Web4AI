     expect(catalog.partEnds().get('MethodModel')).toEqual({ parameters: 'ParameterModel' });
     expect([...catalog.partHeirs()].sort(), 'overriding declarations (ModelUnit is their ancestor)').toEqual(['ClassModel', 'MethodModel']);

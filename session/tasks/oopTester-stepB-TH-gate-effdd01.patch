+      const want = { namespace: 1, dependencies: c.imports.length, headers: 1, attributes: c.attributes.length, ends: inv.memberEnds().length, members: c.methods.length };
+      const got = { namespace: p.namespace.length, dependencies: p.dependencies.length, headers: p.headers.length, attributes: p.attributes.length, ends: p.ends.length, members: p.members.length };
+      if (JSON.stringify(got) !== JSON.stringify(want)) off.push(`${c.name}: got ${JSON.stringify(got)} want ${JSON.stringify(want)}`);
+      for (const u of p.unclassified) off.push(`${c.name}: unclassified ${u}`);
+    }
+    expect(off).toEqual([]);

+import { readFileSync } from 'node:fs';
+import { beforeAll, describe, expect, it } from 'vitest';
+import { Child } from '../../../../../latest/test/Child.js';
+import { M1Catalog } from '../../../../M1/M1Catalog/latest/src/ts/EAM/layer2/M1Catalog.js';
+import { M1Layout } from '../../../../M1/M1Layout/latest/src/ts/EAM/layer2/M1Layout.js';
+import { M2ThingClass } from '../src/ts/EAM/layer2/M2ThingClass.js';
+import { ThinglishGrammar } from '../../../../../ThinglishGrammar/latest/src/ts/EAM/layer2/ThinglishGrammar.js';
+
+/**
+ * oopTester's TARGET gate for pure Thinglish (spec/thinglish.md, src/thinglish section, TH1–TH5) — the WHOLE catalog against
+ * the COMMITTED `.thing` files. Expectations come from the MODEL (catalog) and the GRAMMAR (ThinglishGrammar), never from
+ * M2ThingClass's own rendering (an oracle must not be the code under test). Reported at the weakest literal: TH3 asserts
+ * each model fact's identifying token on its line kind in the committed text — not a full parse-equality.
+ */
+type ClassOf = ReturnType<M1Catalog['classes']>[number];
+type Attr = ClassOf['attributes'][number];
+type Meth = ClassOf['methods'][number];
+type Rel = ClassOf['relationships'][number];
+
+const esc = (s: string): string => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+/** The committed `.thing` files and their text — derived from git, never a hand list. */
+class ThingFiles {
+  constructor() {}
+  init(): this {
+    return this;
+  }
+  tracked(): string[] {
+    return Child.execFileSync('git', ['ls-files', '*.thing'], { encoding: 'utf8' }).split('\n').filter(Boolean).sort();
+  }
+  text(path: string): string {
+    return readFileSync(path, 'utf8');
+  }
+}
+
+/** One `.thing` text parsed by the GRAMMAR's line shapes (G1–G4), bodies skipped: what every line IS, and every keyword-position token. */
+class ThingParse {
+  namespace: string[] = [];
+  dependencies: string[] = [];
+  headers: string[] = [];
+  attributes: string[] = [];
+  ends: string[] = [];
+  members: string[] = [];
+  unclassified: string[] = [];
+  keywords: { token: string; line: number }[] = [];
+  constructor() {}
+  init(text: string): this {
+    const lines = text.split('\n');
+    let body = false;
+    let literal = false; // inside a multi-line template-literal initializer (TypeScript verbatim, G3): continuation, not a line of its own
+    lines.forEach((line, i) => {
+      if (literal) {
+        if ((line.match(/`/g) ?? []).length % 2 === 1) literal = false;
+        return;
+      }
+      if (body) {
+        if (line === '  }') body = false;
+        return;
+      }
+      const kw = (tokens: string[]): void => {
+        for (const t of tokens.filter(Boolean)) this.keywords.push({ token: t, line: i + 1 });
+      };
+      let m: RegExpExecArray | null;
+      if (line.trim() === '' || line === '}') return;
+      if ((m = /^(namespace) \S+$/.exec(line))) {
+        this.namespace.push(line);
+        kw([m[1] ?? '']);
+      } else if ((m = /^(dependency) \S+$/.exec(line))) {
+        this.dependencies.push(line);
+        kw([m[1] ?? '']);
+      } else if (/^(?:[a-z]+ )*(?:class|interface) \S/.test(line) && line.endsWith(' {')) {
+        this.headers.push(line);
+        let bare = line;
+        while (/<[^<>]*>/.test(bare)) bare = bare.replace(/<[^<>]*>/g, '');
+        kw(bare.match(/\b[a-z]\w*\b/g) ?? []);
+      } else if ((m = /^ {2}((?:[a-z]+ )*)(attribute) \w+/.exec(line))) {
+        this.attributes.push(line);
+        kw([...(m[1] ?? '').trim().split(' '), m[2] ?? '']);
+        if ((line.match(/`/g) ?? []).length % 2 === 1) literal = true;
+      } else if ((m = /^ {2}(relationship|collection) \w+\??: \S+ (\w+)(?: (redefines) \w+)?$/.exec(line))) {
+        this.ends.push(line);
+        kw([m[1] ?? '', m[2] ?? '', m[3] ?? '']);
+      } else if ((m = /^ {2}((?:[a-z]+ )*)(property) \w+(?:: .*)? (get|set)(;| \{)?$/.exec(line))) {
+        this.members.push(line);
+        kw([...(m[1] ?? '').trim().split(' '), m[2] ?? '', m[3] ?? '']);
+        if (m[4] === ' {') body = true; // a getter WITH a body (G2): its TypeScript lines are skipped like a method's
+      } else if ((m = /^ {2}((?:[a-z]+ )*)\w+(?:<[^(]*>)?\(/.exec(line))) {
+        this.members.push(line);
+        kw((m[1] ?? '').trim().split(' '));
+        if (line.endsWith(' {')) body = true;
+      } else this.unclassified.push(`${i + 1}: ${line}`);
+    });
+    return this;
+  }
+}
+
+/** The MODEL facts of one class (TH3), each a named token check on the committed text — the held set and derived facts excluded. */
+class FactInventory {
+  private c: ClassOf | undefined = undefined;
+  private versions: string[] = [];
+  constructor() {}
+  init(c: ClassOf, versions: string[]): this {
+    this.c = c;
+    this.versions = versions;
+    return this;
+  }
+  private get cls(): ClassOf {
+    if (this.c === undefined) throw new Error('FactInventory: init(c) first');
+    return this.c;
+  }
+  /** Class-level relationships rendered as HEADER clauses (oopPO F4/F5) vs member ends (G4); generalization/realization mirror extends/implements. */
+  memberEnds(): Rel[] {
+    return this.cls.relationships.filter((r) => ['contains', 'containedBy', 'references'].includes(r.kind) && r.name !== '');
+  }
+  private headerClauses(): Rel[] {
+    return this.cls.relationships.filter((r) => r.kind === 'instanceOf' || (r.kind === 'containedBy' && r.name === ''));
+  }
+  /** The facts absent from `text`, each named `Class.fact` — empty = every non-held, non-derived fact present. */
+  missing(text: string): string[] {
+    const c = this.cls;
+    const lines = text.split('\n');
+    const out: string[] = [];
+    const need = (ok: boolean, fact: string): void => {
+      if (!ok) out.push(`${c.name}.${fact}`);
+    };
+    const header = lines.find((l) => /^(?:[a-z]+ )*(?:class|interface) \S/.test(l) && l.endsWith(' {')) ?? '';
+    const ns = lines[0] ?? '';
+    need(/^namespace \S+$/.test(ns) && (c.namespace === '' || ns.endsWith(`.${c.namespace}`)), 'namespace');
+    for (const i of c.imports) need(lines.some((l) => new RegExp(`^dependency \\S*\\.${esc(i.declaredBy)}\\.(${this.versions.map(esc).join('|')})$`).test(l)), `dependency ${i.name}`);
+    need(new RegExp(`\\b${c.isInterface ? 'interface' : 'class'} ${esc(c.name)}[ <]`).test(header), 'kind');
+    need(!c.isAbstract || /^(?:[a-z]+ )*abstract /.test(header), 'isAbstract');
+    need(!c.isEntry || /^(?:[a-z]+ )*entry /.test(header), 'isEntry');
+    need(c.typeParameters.length === 0 || header.includes(`${c.name}<${c.typeParameters.join(', ')}>`), 'typeParameters');
+    need(c.superclass === '' || new RegExp(` extends (?:[^{]*[ ,])?${esc(c.superclass)}(?:[ ,{]|$)`).test(header), 'superclass');
+    for (const t of c.interfaces) need(new RegExp(`[ ,]${esc(t)}(?:[ ,{]|$)`).test(header.replace(/^[^]*?\b(?:implements|extends) /, ' ')), `implements ${t}`);
+    for (const r of this.headerClauses()) need(header.includes(` ${r.kind} `) && new RegExp(`\\b${esc(r.target)}\\b`).test(header), `${r.kind} ${r.target} (header clause)`);
+    for (const a of c.attributes) out.push(...this.attributeMissing(a, lines, text));
+    for (const r of this.memberEnds()) out.push(...this.endMissing(r, lines));
+    for (const m of c.methods) out.push(...this.methodMissing(m, lines));
+    return out;
+  }
+  private attributeMissing(a: Attr, lines: string[], text: string): string[] {
+    const n = `${this.cls.name}.${a.name}`;
+    const l = lines.find((x) => new RegExp(`^ {2}(?:[a-z]+ )*attribute ${esc(a.name)}(?::| =|$)`).test(x));
+    if (l === undefined) return [`${n} (attribute)`];
+    const pre = l.slice(0, l.indexOf('attribute '));
+    const out: string[] = [];
+    if (a.type !== '' && !l.includes(`${a.name}: ${a.type}`)) out.push(`${n}.type`);
+    if (a.initializer !== '' && !text.includes(`attribute ${a.name}${a.type === '' ? '' : `: ${a.type}`} = ${a.initializer}`)) out.push(`${n}.initializer`); // multi-line safe
+    if (a.isStatic && !pre.includes('static ')) out.push(`${n}.isStatic`);
+    if (a.visibility !== 'public' && !pre.includes(`${a.visibility} `)) out.push(`${n}.visibility`);
+    if (a.isOverride && !pre.includes('override ')) out.push(`${n}.isOverride`);
+    if (a.isReadonly && !pre.includes('readonly ')) out.push(`${n}.isReadonly`);
+    return out;
+  }
+  private endLine(r: Rel, lines: string[]): string | undefined {
+    return lines.find((x) => new RegExp(`^ {2}(?:relationship|collection) ${esc(r.name)}\\??: `).test(x));
+  }
+  private endMissing(r: Rel, lines: string[]): string[] {
+    const n = `${this.cls.name}.${r.name}`;
+    const l = this.endLine(r, lines);
+    if (l === undefined) return [`${n} (${r.kind} end)`];
+    const out: string[] = [];
+    const many = r.multiplicity.endsWith('n'); // G4: to many = collection (oracle of the grammar rule, not the renderer)
+    const optional = r.multiplicity.startsWith('0'); // F2: lower bound 0 = `?`
+    if (!l.startsWith(`  ${many ? 'collection' : 'relationship'} `)) out.push(`${n}.multiplicity (relationship|collection)`);
+    if (l.includes(`${r.name}?:`) !== optional) out.push(`${n}.multiplicity (? = lower bound 0)`);
+    if (!l.includes(`: ${r.target} ${r.kind}`)) out.push(`${n}.target+kind`);
+    if (r.redefines !== '' && !l.endsWith(` redefines ${r.redefines}`)) out.push(`${n}.redefines`);
+    return out;
+  }
+  private methodMissing(m: Meth, lines: string[]): string[] {
+    const n = `${this.cls.name}.${m.name}`;
+    const at = lines.findIndex((x) =>
+      m.isGetter ? new RegExp(`^ {2}(?:[a-z]+ )*property ${esc(m.name)}(?::| get)`).test(x) : new RegExp(`^ {2}(?:[a-z]+ )*${esc(m.name)}(?:<[^(]*>)?\\(`).test(x),
+    );
+    if (at < 0) return [`${n} (${m.isGetter ? 'property' : 'method'})`];
+    const l = lines[at] ?? '';
+    const pre = l.slice(0, l.search(m.isGetter ? /property / : new RegExp(`${esc(m.name)}(?:<|\\()`)));
+    const out: string[] = [];
+    const abstract = m.isAbstract || this.cls.isInterface;
+    if (m.typeParameters.length > 0 && !l.includes(`${m.name}<${m.typeParameters.join(', ')}>(`)) out.push(`${n}.typeParameters`);
+    for (const p of m.parameters) {
+      const token = `${p.isRest ? '...' : ''}${p.name}${p.isOptional ? '?' : ''}`;
+      if (!new RegExp(`[(,] ?${esc(token)}(?::|,| =|\\))`).test(l)) out.push(`${n}(${p.name}) ${p.isRest ? '...' : ''}${p.isOptional ? '?' : ''}name`);
+      if (p.type !== '' && !l.includes(`${token}: ${p.type}`)) out.push(`${n}(${p.name}).type`);
+      if (p.defaultValue !== '' && !l.includes(` = ${p.defaultValue}`)) out.push(`${n}(${p.name}).defaultValue`);
+    }
+    if (m.returnType !== '' && !l.includes(m.isGetter ? `${m.name}: ${m.returnType} ` : `): ${m.returnType}`)) out.push(`${n}.returnType`);
+    if (abstract && !(l.endsWith(';') && pre.includes('abstract '))) out.push(`${n}.isAbstract (abstract …;)`);
+    if (m.isStatic && !pre.includes('static ')) out.push(`${n}.isStatic`);
+    if (m.visibility !== 'public' && !pre.includes(`${m.visibility} `)) out.push(`${n}.visibility`);
+    if (m.isOverride && !pre.includes('override ')) out.push(`${n}.isOverride`);
+    if (m.isAsync && !pre.includes('async ')) out.push(`${n}.isAsync`);
+    if (!abstract) {
+      const body = m.body.map((b) => (b === '' ? '' : `    ${b}`));
+      const got = lines.slice(at + 1, at + 1 + body.length);
+      if (JSON.stringify(got) !== JSON.stringify(body) || lines[at + 1 + body.length] !== '  }') out.push(`${n}.body`);
+    }
+    return out;
+  }
+  /** TH3's HELD set, re-derived from the MODEL (G5 + F3) independently of M2ThingClass.held(). */
+  held(): string[] {
+    const c = this.cls;
+    return [
+      ...['TypedModel.uuid', 'ItemModel.displayName', 'ItemModel.icon', 'ItemModel.badge', 'ItemModel.description'],
+      ...c.typeAliases.map((t) => `TypeAliasModel ${t.name}`),
+      ...c.imports.filter((i) => i.isTypeOnly).map((i) => `ImportModel.isTypeOnly ${i.name}`),
+    ];
+  }
+  /** Held facts must be ABSENT: no element's uuid appears in the text (uuids are unique, so a hit is a leak, never a coincidence). */
+  leakedUuids(text: string): string[] {
+    const c = this.cls;
+    const units: { uuid: string; name: string }[] = [c, ...c.attributes, ...c.methods, ...c.relationships, ...c.imports];
+    return units.filter((u) => u.uuid !== '' && text.includes(u.uuid)).map((u) => `${c.name}: ${u.name} uuid`);
+  }
+}
+
+describe('Thinglish TARGET gate (oopTester, spec/thinglish.md TH1–TH5) — the whole catalog vs the committed .thing files', () => {
+  const catalog = new M1Catalog().init();
+  const grammar = new ThinglishGrammar().init();
+  const files = new ThingFiles().init();
+  let layout: M1Layout | undefined = undefined;
+  const expectedPath = (c: ClassOf): string => {
+    if (layout === undefined) throw new Error('layout not loaded');
+    return `${layout.classFolder(c.name, 'thinglish').path}/${c.name}.${c.isInterface ? 'interface' : 'class'}.thing`;
+  };
+  const pathOf = new Map<string, string>();
+  beforeAll(async () => {
+    await M1Catalog.load();
+    await M1Layout.load(catalog);
+    layout = catalog.homeLayout('');
+    for (const c of catalog.classes()) pathOf.set(c.name, expectedPath(c));
+  });
+  const thingOf = (c: ClassOf): string => files.text(pathOf.get(c.name) ?? '');
+  const tracked = (): string[] => files.tracked();
+  const fileVerdict = (expected: string[], have: string[]): { missing: string[]; extra: string[] } => ({
+    missing: expected.filter((p) => !have.includes(p)).sort(),
+    extra: have.filter((p) => !expected.includes(p)).sort(),
+  });
+
+  /** A renderer with ONE seeded defect: the seed must turn a gate RED by name (an untested gate is not a gate). */
+  const seeded = (render: M2ThingClass, c: ClassOf): string => {
+    render.within(catalog.homeLayout(''));
+    const m1 = render.createExisting(catalog).find((x) => x.name === c.name);
+    return m1?.toSource() ?? '';
+  };
+  const find = (pred: (c: ClassOf) => boolean, what: string): ClassOf => {
+    const c = catalog.classes().find(pred);
+    if (c === undefined) throw new Error(`no catalogued class has ${what} — the seed would be vacuous`);
+    return c;
+  };
+
+  it('TH1 one file per type, DERIVED from the catalog: CHECKED / SKIPPED 0 / TOTAL; the right kind', () => {
+    const expected = catalog.classes().map((c) => pathOf.get(c.name) ?? '').sort();
+    const v = fileVerdict(expected, tracked());
+    const checked = expected.length - v.missing.length;
+    console.log(`TH1: CHECKED ${checked} / SKIPPED 0 / TOTAL ${expected.length} (interfaces ${catalog.interfaceClasses().length})`);
+    expect(expected.length, 'not hollow').toBe(catalog.classes().length);
+    expect(expected.length).toBeGreaterThan(0);
+    expect(v).toEqual({ missing: [], extra: [] });
+    expect(tracked().filter((p) => p.endsWith('.interface.thing')).length).toBe(catalog.interfaceClasses().length);
+  });
+
+  it('TH1 is failable: a MISSING file and a WRONG-KIND file are each RED by name', () => {
+    const expected = catalog.classes().map((c) => pathOf.get(c.name) ?? '').sort();
+    const [first] = expected;
+    expect(fileVerdict(expected, expected.slice(1)).missing).toEqual([first]);
+    const wrong = expected.map((p) => (p === first ? p.replace(/\.(class|interface)\.thing$/, (_, k: string) => `.${k === 'class' ? 'interface' : 'class'}.thing`) : p));
+    const v = fileVerdict(expected, wrong);
+    expect([v.missing, v.extra.length]).toEqual([[first], 1]);
+  });
+
+  it('TH2 generated from the model: every committed .thing is IN the real pipeline\'s byte-compare scope (Pipeline.test "reproduces them byte for byte")', () => {
+    const outside = tracked().filter((p) => !catalog.isGenerated(p));
+    expect(outside, 'a .thing the real-pipeline gate would not compare (hand-editable without RED)').toEqual([]);
+    expect(catalog.homeDirectories).toContain('thinglish');
+  });
+
+  it('TH3 lossless except EXACTLY the held set — every model fact present in the COMMITTED text; held(c) exact; no held uuid leaks', () => {
+    const thing = new M2ThingClass().init().within(catalog.homeLayout(''));
+    const missing: string[] = [];
+    const heldDiff: string[] = [];
+    const leaks: string[] = [];
+    let facts = 0;
+    for (const c of catalog.classes()) {
+      const inv = new FactInventory().init(c, grammar.versionValues);
+      const text = thingOf(c);
+      missing.push(...inv.missing(text));
+      leaks.push(...inv.leakedUuids(text));
+      if (JSON.stringify(thing.held(c)) !== JSON.stringify(inv.held())) heldDiff.push(c.name);
+      facts += 1 + c.imports.length + 1 + c.attributes.length + inv.memberEnds().length + c.methods.length;
+    }
+    console.log(`TH3 MISSING (printed so none hides): ${missing.join(' | ')}`);
+    console.log(`TH3: ${catalog.classes().length} classes, ${facts} fact groups checked; derived (counted present): RelationshipModel.source, ClassModel.level, ImportModel.isInterface, typeArguments`);
+    expect(facts).toBeGreaterThan(catalog.classes().length * 3); // not hollow
+    expect(missing, 'model facts absent from the committed .thing').toEqual([]);
+    expect(heldDiff, 'held(c) differs from the held set re-derived from the model (G5 + F3)').toEqual([]);
+    expect(leaks, 'a HELD uuid rendered').toEqual([]);
+  });
+
+  it('TH3 is failable: each seeded renderer drop is RED by the named fact', () => {
+    const withInit = find((c) => c.attributes.some((a) => a.initializer !== ''), 'an initialized attribute');
+    class DropInitializer extends M2ThingClass {
+      protected override attributeLine(a: Attr): string {
+        return super.attributeLine(a).replace(/ = .*$/, '');
+      }
+    }
+    expect(new FactInventory().init(withInit, grammar.versionValues).missing(seeded(new DropInitializer().init(), withInit)).some((f) => f.endsWith('.initializer'))).toBe(true);
+
+    const withOptional = find((c) => c.methods.some((m) => m.parameters.some((p) => p.isOptional)), 'an optional parameter');
+    class DropOptional extends M2ThingClass {
+      protected override parameterText(p: Meth['parameters'][number]): string {
+        return super.parameterText(p).replace('?', '');
+      }
+    }
+    expect(new FactInventory().init(withOptional, grammar.versionValues).missing(seeded(new DropOptional().init(), withOptional)).some((f) => f.endsWith('?name'))).toBe(true);
+
+    const withRedefines = find((c) => c.relationships.some((r) => r.redefines !== '' && r.name !== ''), 'a redefining end');
+    class DropRedefines extends M2ThingClass {
+      protected override endLine(r: Rel): string {
+        return super.endLine(r).replace(/ redefines \w+$/, '');
+      }
+    }
+    expect(new FactInventory().init(withRedefines, grammar.versionValues).missing(seeded(new DropRedefines().init(), withRedefines)).some((f) => f.endsWith('.redefines'))).toBe(true);
+
+    const withBody = find((c) => !c.isInterface && c.methods.some((m) => !m.isAbstract && m.body.length > 0), 'a method body');
+    class DropBodyLine extends M2ThingClass {
+      protected override methodLines(m: Meth, c: ClassOf): string[] {
+        const l = super.methodLines(m, c);
+        return l.length > 2 ? [...l.slice(0, -2), ...l.slice(-1)] : l;
+      }
+    }
+    expect(new FactInventory().init(withBody, grammar.versionValues).missing(seeded(new DropBodyLine().init(), withBody)).some((f) => f.endsWith('.body'))).toBe(true);
+
+    const withImport = find((c) => c.imports.length > 0, 'a dependency');
+    class DropDependency extends M2ThingClass {
+      override sourceOf(c: ClassOf): string {
+        return super.sourceOf(c).replace(/^dependency .*\n/m, '');
+      }
+    }
+    expect(new FactInventory().init(withImport, grammar.versionValues).missing(seeded(new DropDependency().init(), withImport)).some((f) => f.includes('.dependency '))).toBe(true);
+
+    const withContainer = find((c) => c.relationships.some((r) => r.kind === 'containedBy' && r.name === ''), 'a role-less containedBy (F4)');
+    class DropHeaderClause extends M2ThingClass {
+      protected override headerOf(c: ClassOf): string {
+        return super.headerOf(c).replace(/ containedBy \w+/, '');
+      }
+    }
+    expect(new FactInventory().init(withContainer, grammar.versionValues).missing(seeded(new DropHeaderClause().init(), withContainer)).some((f) => f.includes('containedBy') && f.endsWith('(header clause)'))).toBe(true);
+
+    class LeakUuid extends M2ThingClass {
+      override sourceOf(c: ClassOf): string {
+        return `${super.sourceOf(c)}${c.uuid}\n`;
+      }
+    }
+    expect(new FactInventory().init(withImport, grammar.versionValues).leakedUuids(seeded(new LeakUuid().init(), withImport))).toEqual([`${withImport.name}: ${withImport.name} uuid`]);
+    expect(JSON.stringify(new FactInventory().init(withImport, grammar.versionValues).held().slice(1))).not.toBe(JSON.stringify(new M2ThingClass().init().held(withImport)));
+  });
+
+  it('TH4 only GRAMMAR keywords: every keyword-position token in every .thing belongs to the set DERIVED from ThinglishGrammar', () => {
+    const allowed = grammar.keywords;
+    const offenders: string[] = [];
+    const used = new Map<string, number>();
+    for (const p of tracked()) {
+      for (const k of new ThingParse().init(files.text(p)).keywords) {
+        used.set(k.token, (used.get(k.token) ?? 0) + 1);
+        if (!allowed.includes(k.token)) offenders.push(`${p}:${k.line} ${k.token}`);
+      }
+    }
+    console.log(`TH4: grammar keywords ${allowed.length}; used ${used.size}: ${[...used.entries()].map(([k, n]) => `${k}×${n}`).join(' ')}`);
+    expect(allowed.length).toBeGreaterThan(0);
+    expect(used.size).toBeGreaterThan(5); // not hollow: real keywords were seen
+    expect(offenders).toEqual([]);
+  });
+
+  it('TH4 is failable: an INVENTED keyword in a member line or a header clause is RED by name', () => {

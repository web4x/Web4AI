@@ -0,0 +1,73 @@
+import type { M1Catalog } from '../../MOF/M1/M1Catalog/latest/src/ts/EAM/layer2/M1Catalog.js';
+
+/** A catalogued class model, as the gates read it. */
+export type ClassOf = ReturnType<M1Catalog['classes']>[number];
+
+/** Regex-escape a name. */
+export const esc = (s: string): string => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+/** A type text without its type arguments (`UcpComponent<X>` -> `UcpComponent`). */
+export const bare = (t: string): string => t.replace(/<.*$/, '').trim();
+
+/**
+ * PURE Thinglish's type layout, DERIVED from MODEL references (spec v4 rule 4, ruled by oopPO from oopTester's measured
+ * reading): a MODEL (descends from `Model`) INLINES into its owner iff it has exactly ONE referrer (imports it / names it in
+ * superclass, interfaces or type parameters), that referrer is a NON-model class, and nothing extends it; otherwise the
+ * model renders as an INTERFACE (rules 5–7). The one hand fact is Tron's ruled RENAME (ruling 6).
+ * ONE owner of this derivation (oopTester): ThinglishTarget and the target-LISTING oracles (M1Catalog, M1Layout) all ask this class.
+ */
+export class PureLayout {
+  private all: ClassOf[] = [];
+  private byName = new Map<string, ClassOf>();
+  constructor() {}
+  init(classes: ClassOf[]): this {
+    this.all = classes;
+    this.byName = new Map(classes.map((c) => [c.name, c]));
+    return this;
+  }
+  /** Tron's ruling 6 — the ONLY hand fact: a model renamed in pure Thinglish. */
+  get renames(): Record<string, string> {
+    return { ItemModel: 'ItemView' };
+  }
+  get classes(): ClassOf[] {
+    return this.all;
+  }
+  named(name: string): ClassOf | undefined {
+    return this.byName.get(name);
+  }
+  isModel(c: ClassOf | undefined, seen = new Set<string>()): boolean {
+    if (c === undefined || seen.has(c.name)) return false;
+    if (c.name === 'Model') return true;
+    seen.add(c.name);
+    return this.isModel(this.byName.get(bare(c.superclass)), seen);
+  }
+  referrers(m: string): ClassOf[] {
+    const w = new RegExp(`\\b${esc(m)}\\b`);
+    return this.all.filter((c) => c.name !== m && (c.imports.some((i) => i.name === m) || w.test(c.superclass) || c.interfaces.some((t) => w.test(t)) || c.typeParameters.some((t) => w.test(t))));
+  }
+  extenders(m: string): ClassOf[] {
+    return this.all.filter((c) => bare(c.superclass) === m);
+  }
+  /** The owner a model inlines into — or undefined when it renders as an interface. */
+  ownerOf(c: ClassOf): ClassOf | undefined {
+    if (!this.isModel(c)) return undefined;
+    const refs = this.referrers(c.name);
+    const [only] = refs;
+    return refs.length === 1 && only !== undefined && !this.isModel(only) && this.extenders(c.name).length === 0 ? only : undefined;
+  }
+  isInlined(c: ClassOf): boolean {
+    return this.ownerOf(c) !== undefined;
+  }
+  inlinedInto(owner: ClassOf): ClassOf[] {
+    return this.all.filter((m) => this.ownerOf(m)?.name === owner.name);
+  }
+  /** The types pure Thinglish SHOWS (one file each, TH1): every class except an inlined model. */
+  shown(): ClassOf[] {
+    return this.all.filter((c) => !this.isInlined(c));
+  }
+  isInterfaceType(c: ClassOf): boolean {
+    return c.isInterface || (this.isModel(c) && !this.isInlined(c));
+  }
+  typeName(name: string): string {
+    return this.renames[name] ?? name;
+  }
+}

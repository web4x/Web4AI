+  /**
+   * ARM6 scope, fixed STRUCTURALLY before any result was seen (oopTester 2026-10-02): a TOP-LEVEL path mention is
+   * `gen/`, `src/` or `test/` (and anything after it) NOT preceded by a path character — so `<C>/latest/src/ts/X.ts`
+   * is a component path and out of scope, while bare `src/`, `gen/js/` or prose "test/Foo.test.ts" are in. Backticked
+   * or not, with or without an extension: this is exactly what ARM5 (backticked file citations only) cannot see.
+   */
+  topLevelMentions(line: string): string[] {
+    return [...line.matchAll(/(?<![A-Za-z0-9_./@-])(?:gen|src|test)\/[^\s`'"“”‘’()[\]|,;*]*/g)].map((m) => m[0]);
+  }
+  /** One line -> top-level mentions that are LIVE (violations) vs SKIPPED with the structural marker that exempts them. */
+  classifyTopLevel(line: string): { violations: string[]; skipped: string[] } {
+    const all = this.topLevelMentions(line);
+    if (all.length === 0) return { violations: [], skipped: [] };
+    if (/^\s*>/.test(line)) return { violations: [], skipped: all.map((m) => `${m} [blockquote]`) };
+    const blank = (x: string): string => ' '.repeat(x.length);
+    const noStruck = line.replace(/~~[^~]*~~/g, blank);
+    const live = this.topLevelMentions(noStruck.replace(/"[^"]*"|“[^”]*”/g, blank));
+    const afterStrike = this.topLevelMentions(noStruck);
+    const pool = [...live];
+    const take = (m: string): boolean => {
+      const i = pool.indexOf(m);
+      if (i < 0) return false;
+      pool.splice(i, 1);
+      return true;
+    };
+    const skipped: string[] = [];
+    const strikePool = [...afterStrike];
+    for (const m of all) {
+      if (take(m)) continue;
+      const i = strikePool.indexOf(m);
+      if (i >= 0) {
+        strikePool.splice(i, 1);
+        skipped.push(`${m} [verbatim]`);
+      } else skipped.push(`${m} [struck]`);
+    }
+    return { violations: live, skipped };
+  }
+  scanTopLevel(files = this.docFiles()): { violations: string[]; skipped: string[]; total: number } {
+    const violations: string[] = [];
+    const skipped: string[] = [];
+    for (const file of files) {
+      readFileSync(file, 'utf8')
+        .split('\n')
+        .forEach((line, i) => {
+          const c = this.classifyTopLevel(line);
+          for (const v of c.violations) violations.push(`${file}:${i + 1} ${v}`);
+          for (const k of c.skipped) skipped.push(`${file}:${i + 1} ${k}`);
+        });
+    }
+    return { violations: violations.sort(), skipped: skipped.sort(), total: violations.length + skipped.length };
+  }
 }
 

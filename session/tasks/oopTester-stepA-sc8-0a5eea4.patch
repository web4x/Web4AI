+/**
+ * The HELD table of spec/thinglish.md (plan of record G5): model facts the grammar does NOT express — not rendered, not
+ * invented, never mapped by a keyword. Rows under `| Model fact | Why held |`, the first backticked token of each row:
+ * `XModel` (a whole catalogued class) or `XModel.attr` (one attribute of it). DERIVED from the document.
+ */
+class HeldTable {
+  private facts: string[] = [];
+  constructor() {}
+  init(spec: string): this {
+    const table = /^\| Model fact \| Why held \|[^\n]*\n\|[-| ]+\|\n((?:\|[^\n]*\n)+)/m.exec(spec)?.[1] ?? '';
+    this.facts = table
+      .split('\n')
+      .filter((l) => l.startsWith('|'))
+      .map((l) => /`([A-Za-z]+(?:\.[A-Za-z]+)?)`/.exec(l.split('|')[1] ?? '')?.[1] ?? '')
+      .filter((f) => f !== '');
+    return this;
+  }
+  get all(): string[] {
+    return this.facts;
+  }
+}
+
+/** Does a held fact EXIST in the catalog — `XModel` a catalogued class, `XModel.attr` an attribute of it? (a stale held row is RED) */
+function existsInCatalog(fact: string): boolean {
+  const [model, attribute] = fact.split('.');
+  const cls = new M1Catalog().init().classes().find((c) => c.name === model);
+  return cls !== undefined && (attribute === undefined || cls.attributes.some((a) => a.name === attribute));
+}
+
+/**
+ * Which ATTRIBUTE of a catalogued model a modifier keyword sets — GROUND TRUTH from the catalog, never a hand list:
+ * an attribute named exactly the keyword (`redefines`), or `is<Keyword>` (`isAbstract`), or one whose declared type is a
+ * union literal holding the keyword (`visibility: 'public' | 'protected' | 'private'`). '' = the model cannot hold it.
+ */
+function attributeFor(keyword: string, model: string): string {
+  const cls = new M1Catalog().init().classes().find((c) => c.name === model);
+  const attributes = cls?.attributes ?? [];
+  const is = `is${keyword.charAt(0).toUpperCase()}${keyword.slice(1)}`;
+  return (
+    attributes.find((a) => a.name === keyword)?.name ??
+    attributes.find((a) => a.name === is)?.name ??
+    attributes.find((a) => new RegExp(`'${keyword}'`).test(a.type ?? ''))?.name ??
+    ''
+  );
+}
+
+/** The grammar's declared modifier map (`ThinglishGrammar.modifiers`: keyword → ['M3X.attribute', …]); absent = none declared. */
+function declaredModifiers(grammar: object): Record<string, string[]> {
+  return (Reflect.get(grammar, 'modifiers') as Record<string, string[]> | undefined) ?? {};
+}

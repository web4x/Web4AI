+  /** One line -> top-level mentions that are LIVE (violations) vs SKIPPED with the structural marker that exempts them. */
+  classifyTopLevel(line: string): { violations: string[]; skipped: string[] } {
+    const all = this.topLevelMentions(line);
+    if (all.length === 0) return { violations: [], skipped: [] };
+    if (/^\s*>/.test(line)) return { violations: [], skipped: all.map((m) => `${m} [blockquote]`) };
+    const blank = (x: string): string => ' '.repeat(x.length);
+    const noStruck = line.replace(/~~[^~]*~~/g, blank);
+    // ruling oopPO 2026-10-02: a quote is exempt ONLY when EXPLICITLY attributed to Tron — `Tron` within 40 chars before
+    // the opening quote, no other quote between (`Tron, 2026-09-21: "…"`, `Tron: “…”`). An unattributed quote is LIVE:
+    // quoting a stale path must never hide it (a generic quote exemption is an evasion hole).
+    const live = this.topLevelMentions(noStruck.replace(/(?<=\bTron\b[^"“”\n]{0,40})("[^"]*"|“[^”]*”)/g, blank));
+    const afterStrike = this.topLevelMentions(noStruck);
+    const pool = [...live];
+    const take = (m: string): boolean => {
+      const i = pool.indexOf(m);
+      if (i < 0) return false;
+      pool.splice(i, 1);
+      return true;
+    };
+    const skipped: string[] = [];
+    const strikePool = [...afterStrike];
+    for (const m of all) {
+      if (take(m)) continue;
+      const i = strikePool.indexOf(m);
+      if (i >= 0) {
+        strikePool.splice(i, 1);
+        skipped.push(`${m} [tron-verbatim]`);
+      } else skipped.push(`${m} [struck]`);
+    }
+    return { violations: live, skipped };
+  }
+  /**
+   * ARM6 tree-awareness (oopPO ruling 2026-10-02 — DERIVED from structure, never a marker): inside a ``` fence, a row's
+   * depth is its leading run of spaces / box glyphs (│├└─), its ancestors are the nearest preceding rows of smaller depth,
+   * and a row NESTED under a row whose name ends in `latest/` is COMPONENT-RELATIVE (its `src/`, `test/` are the
+   * component's). Outside a fence there is no tree; the fence resets on close; the `latest/` row itself is not exempt.
+   * Returns the 0-based indices of the component-relative rows.
+   */
+  componentRelativeRows(lines: string[]): Set<number> {
+    const rows = new Set<number>();
+    let fenced = false;
+    let stack: { depth: number; name: string }[] = [];
+    lines.forEach((line, i) => {
+      if (/^\s*```/.test(line)) {
+        fenced = !fenced;
+        stack = [];
+        return;
+      }
+      if (!fenced || line.trim() === '') return;
+      const depth = (/^[\s│├└─]*/.exec(line)?.[0] ?? '').length;
+      const name = line.slice(depth).split(/\s+/)[0] ?? '';
+      while (stack.length > 0 && (stack[stack.length - 1]?.depth ?? 0) >= depth) stack.pop();
+      if (stack.some((a) => a.name.endsWith('latest/'))) rows.add(i);
+      stack.push({ depth, name });
+    });
+    return rows;
+  }
+  scanTopLevel(files = this.docFiles()): { violations: string[]; skipped: string[]; tree: string[]; total: number } {
+    const violations: string[] = [];
+    const skipped: string[] = [];
+    const tree: string[] = [];
+    for (const file of files) {
+      const lines = readFileSync(file, 'utf8').split('\n');
+      const relative = this.componentRelativeRows(lines);
+      lines.forEach((line, i) => {
+        if (relative.has(i)) {
+          for (const m of this.topLevelMentions(line)) tree.push(`${file}:${i + 1} ${m} [component-relative row]`);
+          return;
+        }
+        const c = this.classifyTopLevel(line);
+        for (const v of c.violations) violations.push(`${file}:${i + 1} ${v}`);
+        for (const k of c.skipped) skipped.push(`${file}:${i + 1} ${k}`);
+      });
+    }
+    return { violations: violations.sort(), skipped: skipped.sort(), tree: tree.sort(), total: violations.length + skipped.length };
+  }
